# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database (Neon Postgres in production, local Postgres in dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/collabsphere
DATABASE_SSL=false

# JWT
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Email (Nodemailer - use an SMTP provider; Gmail app password works for dev)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="CollabSphere <no-reply@collabsphere.dev>"

# Cloudinary (used by later modules)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
